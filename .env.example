# Connection settings for the Ollama server.
# Copy this file to .env and adjust the values. Variables already set in your
# shell take precedence over the ones in .env.

# URL of the Ollama server (default: http://127.0.0.1:11434).
# Note: this is the address the client CONNECTS to. If the server listens on
# 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434), use 127.0.0.1 on the same machine or the
# server's LAN IP from another machine, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: API key, sent as "Authorization: Bearer <key>".
# Needed only for a server behind an authenticated reverse proxy or for ollama.com.
OLLAMA_API_KEY=
