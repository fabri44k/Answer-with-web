# Connection settings for the LLM providers (secrets stay here, not in config.json).
# Copy this file to .env and adjust the values. Variables already set in your
# shell take precedence over the ones in .env.

# ---------------------------------------------------------------------------
# Ollama (config.json: "llm_provider": "ollama")
# ---------------------------------------------------------------------------

# URL of the Ollama server (default: http://127.0.0.1:11434).
# Note: this is the address the client CONNECTS to. If the server listens on
# 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434), use 127.0.0.1 on the same machine or the
# server's LAN IP from another machine, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: API key, sent as "Authorization: Bearer <key>".
# Needed only for a server behind an authenticated reverse proxy or for ollama.com.
OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# OpenAI compatible provider (config.json: "llm_provider": "openai_compatible")
# Any server exposing the OpenAI Chat Completions API works: OpenRouter,
# Requesty, but also local ones like LM Studio, llama.cpp or vLLM.
# ---------------------------------------------------------------------------

# Base URL of the API, including the version path. Uncomment one:
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_BASE_URL=https://router.requesty.ai/v1

# API key of the provider (required for OpenRouter and Requesty,
# can be left empty for local servers).
OPENAI_COMPATIBLE_API_KEY=
